# TripLog 백엔드 환경변수 예시 (architecture §8).
# 복사해서 .env 로 사용하고 값을 채운다. .env 는 절대 커밋하지 않는다(.gitignore 처리됨).
# 프론트엔드 변수는 frontend/.env.example 참고.

# ===== DB (MySQL) =====
DB_URL=jdbc:mysql://localhost:3306/triplog?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=
DB_PASSWORD=

# ===== JWT =====
# HS256 서명 키. 반드시 32바이트(256bit) 이상.
JWT_SECRET=

# ===== 카카오맵 =====
# 백엔드는 REST 키, 프론트는 JavaScript 키(frontend/.env 의 VITE_KAKAO_MAP_KEY)
KAKAO_MAP_KEY=

# ===== TMAP =====
# 백엔드에서 자동차/도보 구간 소요시간 계산에 사용한다. 프론트엔드에 노출하지 않는다.
TMAP_APP_KEY=
TMAP_ROUTE_BASE_URL=https://apis.openapi.sk.com

# ===== 관광지 표준데이터(TourAPI) =====
TOUR_API_KEY=

# ===== External API client defaults =====
EXTERNAL_API_CONNECT_TIMEOUT=3s
EXTERNAL_API_READ_TIMEOUT=5s
EXTERNAL_API_MAX_ATTEMPTS=3
EXTERNAL_API_BACKOFF=200ms

# ===== AI (SSAFY GMS 우선) =====
SSAFY_GMS_KEY=
# GMS 키를 채운 환경에서만 LLM chat 자동설정을 켠다(opt-in). 비워 두면 기본 none 으로
# 컨텍스트만 살고, 호출 시 AI_001 로 격리된다. GMS 사용 시 아래 줄의 주석을 해제한다:
# SPRING_AI_MODEL_CHAT=openai

# ===== 사진 로컬 저장 경로 =====
UPLOAD_DIR=./uploads

# ===== 윤곽선 추론 서버 (inference/) =====
# 같은 호스트 내부 비공개. 업로드 후 백그라운드 전처리가 이 주소로 호출한다 (S3-LOG-02 #70).
# 기본값이 코드에 있어 로컬에선 비워 둬도 동작한다. 다른 주소/포트로 띄울 때만 채운다.
INFERENCE_BASE_URL=http://127.0.0.1:8765

# ===== CORS 허용 Origin (콤마 구분) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== (P1) 소셜 로그인 OAuth =====
OAUTH_STATE_SECRET=
OAUTH_FRONTEND_SUCCESS_URI=http://localhost:5173/oauth/callback
OAUTH_FRONTEND_FAILURE_URI=http://localhost:5173/login
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_KAKAO_REDIRECT_URI=http://localhost:8080/auth/oauth/kakao/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=http://localhost:8080/auth/oauth/naver/callback

# ===== (선택) AI fallback provider 키 =====
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
