#!/usr/bin/env bash
# TripLog pre-push hook
# - main 브랜치 직접 push 차단 (branch protection 대체)
# - 브랜치명 규칙 경고 (conventions §4-2)
# 설치: bash scripts/install-hooks.sh  (core.hooksPath=scripts/hooks)
set -uo pipefail

protected="main"

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/$protected" ]; then
    echo "✗ '$protected'에 직접 push할 수 없습니다 — feature 브랜치 + PR로 진행하세요 (conventions §1·§4)." >&2
    exit 1
  fi
done

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ -n "$branch" ] && ! echo "$branch" | grep -qE '^(feat|fix|chore|docs)/'; then
  echo "! 브랜치명 '$branch'이 규칙과 다릅니다: {feat|fix|chore|docs}/s{n}-{track}{nn}-{name} (conventions §4-2)." >&2
fi

exit 0
